# Skopiuj do .env i uzupełnij. Plik .env leży na serwerze obok docker-compose.yml (nie trafia do repozytorium ani obrazu).

# Hasło awaryjnego konta admin w panelu /login (login: admin; długie, losowe).
ADMIN_SECRET=

# Klucz podpisu sesji. Puste = losowy, zapisany w data/secret_key.
SECRET_KEY=

# Publiczny adres aplikacji (wchodzi do kodów QR).
PUBLIC_URL=https://helpers-pwr.rupary.pl

# Ważność kodu rejestracyjnego w minutach.
CODE_TTL_MINUTES=60

# Ciasteczka tylko po HTTPS. Lokalnie przez http://localhost ustaw 0.
COOKIE_SECURE=1

# Opcjonalnie, pierwsze wdrożenie: stoiska tworzone przy starcie, jeśli jeszcze ich nie ma.
# Format: id:Nazwa stoiska, po przecinku (stary format id:Nazwa:PIN też działa, PIN jest ignorowany).
# Np. c13:Budynek C-13,w4:Budynek W-4. Po utworzeniu usuń tę linię; konta wolontariuszy zakłada admin w panelu.
BOOTSTRAP_BOOTHS=

# Adres kontaktowy podstawiany w dokumentach prawnych w miejscu {{CONTACT}}. Puste = "[do uzupełnienia]".
# Treści regulaminów i polityki edytuje się w panelu /login (sekcja "Regulaminy i dokumenty").
LEGAL_CONTACT=

# Terminy z regulaminów (czas Europe/Warsaw, RRRR-MM-DDTGG:MM). Puste = domyślne.
# Koniec zliczania punktów Pucharu Dawcy PWr (po nim wpisanie tokenu i generowanie tokenów daje 410):
CUP_DEADLINE=
# Koniec zgłoszeń konkursowych (po nim ekran 10/10 pokazuje, że zgłoszenia są zamknięte):
CONTEST_DEADLINE=
